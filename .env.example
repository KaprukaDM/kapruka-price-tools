# Copy to .env and fill in with your ROTATED keys. Never commit .env.

# OpenAI API key for the match-scoring step.
OPENAI_API_KEY=

# Model for match scoring. gpt-4o-mini (cheap, good) or gpt-4o (more accurate).
MATCH_MODEL=gpt-4o-mini

# SERP provider. Leave SERP_PROVIDER as "auto" to detect from key length
# (64 hex chars -> serpapi, otherwise serper), or set explicitly: serpapi | serper.
SERP_PROVIDER=auto
SERP_API_KEY=

# Optional HTTP(S) proxy (e.g. a Sri-Lankan-exit proxy) to force LKR pricing.
# Leave blank to scrape directly. Example: http://user:pass@host:port
SCRAPE_PROXY=

# Server port
PORT=3000

# Optional: Supabase/Postgres connection string for persistent storage.
# Project Settings -> Database -> Connection string -> URI (pooled, port 6543).
# Needs outbound access to port 5432/6543 -- some networks firewall that off.
# Leave blank to use a local SQLite file (data/price-tools.db) for development.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Alternative to DATABASE_URL: talk to the same Supabase database over its
# REST API (HTTPS/443) instead of a raw Postgres port. Use this when the host
# can't reach 5432/6543 directly. Ignored if DATABASE_URL is set.
# Project Settings -> Data API -> Project URL, and Settings -> API Keys -> service_role (secret) key.
# Run the CREATE TABLE block at the top of src/db.js's Supabase REST backend
# in the Supabase SQL Editor once, first -- PostgREST can't create tables.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Disables the server's own built-in daily auto-refresh loop. Set this on
# every instance if a separate scheduled job (src/tools/refresh-all-partners.js)
# owns refreshing partner comparisons instead.
DISABLE_AUTO_REFRESH=

# Only set this on a host confirmed to get correct LKR pricing from Kapruka
# (test: fetch a Kapruka catalogue page and check whether its JSON-LD
# "priceCurrency" comes back LKR or something else). Adding a partner there
# will kick off an immediate background scrape for faster turnaround. Leave
# unset on any other host -- a partner added there just waits for the
# scheduled job to pick it up from a good host instead.
SCRAPE_ON_ADD=
