{
  "name": "price-checker",
  "version": "1.0.0",
  "description": "AI-assisted price checker: pick a category, enter a product, match prices across curated Sri Lankan sites with a confidence/match rate.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "hot": "node src/hot-server.js",
    "uae-compare": "node src/uae-compare/server.js",
    "intl-gifts:refresh": "node src/uae-compare/cli-refresh.js",
    "intl-gifts:set-pairing": "node src/uae-compare/cli-set-pairing.js",
    "compare": "node src/compare/index.js",
    "relevancy": "node src/tools/find-online-relevancy.js",
    "clear-supabase": "node src/tools/clear-supabase-data.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "pg": "^8.22.0",
    "playwright": "^1.49.1"
  }
}
